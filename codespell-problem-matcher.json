{
  "problemMatcher": [
    {
      "owner": "codespell-matcher-default",
      "pattern": [
        {
          "regexp": "^(FIXED):\\s+(.+)\\s+(.+)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      ]
    },
    {
      "owner": "codespell-matcher-specified",
      "pattern": [
        {
          "regexp": "^(ERROR|WARNING|FIXED):\\s+(.+):\\s+(.+?)\\s*$",
          "file": 3,
          "severity": 1,
          "message": 2
        }
      ]
    }
  ]
}
