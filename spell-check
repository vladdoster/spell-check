#!/usr/bin/env zsh

# spell-check: A standalone CLI tool for spell checking repositories
# Uses codespell to find and fix spelling errors in markdown and text files
#
# Adapted for the spell-check skill from vladdoster/spell- (spell-check zsh CLI).
# Behavioral divergences from the source script, each forced by a real failure
# or safety issue on macOS (see SKILL.md Gotchas):
#   - file selection uses a zsh recursive glob (GNU `find -regextype` does not
#     exist on BSD find)
#   - clone goes to a mktemp -d dir, not ./target-repo (a skill runs from the
#     user's project; `rm -rf target-repo` in their CWD is not acceptable)
#   - adds -n/--dry-run: stop after the report, never fork/push/delete
#   - GH_TOKEN falls back to `gh auth token` (keyring auth leaves the env unset)

set -e
setopt ERR_EXIT PIPE_FAIL

# $0 inside a zsh function is the function name (FUNCTION_ARGZERO), so usage()
# would print "usage" — capture the script name while $0 is still the script.
typeset -g script_name="${0:t}"

# Default values
typeset -g repository=""
typeset -g ignore_words=""
typeset -g skip_files=""
typeset -g delete_fork=0
typeset -g dry_run=0
typeset -g help=0

# Color output
typeset -g RED='\033[0;31m'
typeset -g GREEN='\033[0;32m'
typeset -g YELLOW='\033[1;33m'
typeset -g NC='\033[0m' # No Color

# Print usage information
usage() {
  cat << EOF
Usage: ${script_name} [OPTIONS]

A standalone CLI tool for spell checking repositories using codespell.

OPTIONS:
  -r, --repository REPO    Repository slug (user/repo) [required]
  -i, --ignore WORDS       Space-separated list of words to ignore
  -s, --skip FILES         Comma-separated list of files to skip
  -d, --delete-fork        Delete fork after completion
  -n, --dry-run            Stop after the report; never fork, push, or delete
  -h, --help               Show this help message

EXAMPLES:
  ${script_name} -r owner/repo -n
  ${script_name} -r owner/repo
  ${script_name} -r owner/repo -i "myword anotherword"
  ${script_name} -r owner/repo -s "*.log,*.tmp" -d

REQUIREMENTS:
  - gh (GitHub CLI, authenticated)
  - uv (Python package manager)
  - git

EOF
  exit 0
}

# Print error message and exit
error() {
  printf "${RED}Error: %s${NC}\n" "$1" >&2
  exit 1
}

# Print info message
info() {
  printf "${GREEN}%s${NC}\n" "$1"
}

# Print warning message
warn() {
  printf "${YELLOW}%s${NC}\n" "$1"
}

# Parse command line arguments using zparseopts
parse_args() {
  zparseopts -D -E -F - \
    r:=opt_repository -repository:=opt_repository \
    i:=opt_ignore -ignore:=opt_ignore \
    s:=opt_skip -skip:=opt_skip \
    d=opt_delete_fork -delete-fork=opt_delete_fork \
    n=opt_dry_run -dry-run=opt_dry_run \
    h=opt_help -help=opt_help \
    || {
      error "Invalid options. Use -h or --help for usage information."
    }

  # Process options
  if ((${#opt_help})); then
    usage
  fi

  if ((${#opt_repository})); then
    repository="${opt_repository[-1]}"
  fi

  if ((${#opt_ignore})); then
    ignore_words="${opt_ignore[-1]}"
  fi

  if ((${#opt_skip})); then
    skip_files="${opt_skip[-1]}"
  fi

  if ((${#opt_delete_fork})); then
    delete_fork=1
  fi

  if ((${#opt_dry_run})); then
    dry_run=1
  fi

  # Validate required arguments
  if [[ -z $repository ]]; then
    error "Repository is required. Use -r or --repository to specify."
  fi
}

# Check required commands
check_requirements() {
  local -a missing_commands=()

  for cmd in gh jq uv git; do
    if ! command -v "$cmd" &> /dev/null; then
      missing_commands+=("$cmd")
    fi
  done

  if ((${#missing_commands} > 0)); then
    error "Missing required commands: ${(j:, :)missing_commands}"
  fi

  # gh keyring auth leaves GH_TOKEN unset; mint one so git pushes can use it too.
  if [[ -z $GH_TOKEN ]]; then
    GH_TOKEN="$(gh auth token 2> /dev/null || true)"
    export GH_TOKEN
  fi
  if [[ -z $GH_TOKEN ]]; then
    error "GH_TOKEN is not set and 'gh auth token' returned nothing. Run 'gh auth login'."
  fi
}

# Clean and validate repository input
get_repo_info() {
  info "Processing repository: $repository"

  # Trim trailing slashes
  local trimmed="${repository%/}"

  # Get repository information using gh CLI
  local repo_json
  repo_json=$(gh repo view --json nameWithOwner,name,url "$trimmed" 2> /dev/null) || {
    error "Failed to fetch repository information for: $trimmed"
  }

  typeset -g repo_name=$(echo "$repo_json" | jq -r '.nameWithOwner')
  typeset -g repo_short_name=$(echo "$repo_json" | jq -r '.name')
  typeset -g repo_url=$(echo "$repo_json" | jq -r '.url')
  typeset -g fork_owner="${GITHUB_REPOSITORY_OWNER:-$(gh api user -q '.login')}"
  typeset -g repo_fork="${fork_owner}/${repo_short_name}"
  typeset -g repo_fork_url="https://github.com/${repo_fork}.git"

  # A repo cannot be forked into the account that already owns it — repo_fork would resolve
  # to the target itself, and pushing to the target is never correct. Bail before cloning.
  # Logins are case-insensitive, so compare lowercased.
  if [[ ${(L)fork_owner} == "${(L)repo_name%%/*}" ]]; then
    error "$repo_name is owned by $fork_owner; a fork cannot be created. Run as a different account."
  fi

  info "Repository: $repo_name"
  info "URL: $repo_url"
}

# Clone the target repository
clone_repository() {
  local target_dir
  target_dir="$(mktemp -d)/target-repo"

  info "Cloning repository into ${target_dir}..."
  gh repo clone --no-upstream "$repo_name" "$target_dir" -- --depth=1 || {
    error "Failed to clone repository: $repo_name"
  }

  cd "$target_dir" || error "Failed to change directory to $target_dir"
}

# Run spell check with codespell
run_spell_check() {
  info "Running spell check with codespell..."

  local ignore_file="/tmp/ignore.txt"
  local config_file="/tmp/codespell.cfg"
  typeset -g changes_report="/tmp/spell-changes-report.txt"

  # Create files
  touch "$config_file" "$ignore_file" "$changes_report"

  # Handle ignore words
  if [[ -n $ignore_words ]]; then
    printf '%s\n' $=ignore_words > "$ignore_file"

    if grep -q '[^[:space:]]' "$ignore_file"; then
      info "Ignoring words: $ignore_words"
    else
      warn "Ignore file is empty or contains only whitespace"
    fi
  else
    # touch keeps a stale list from an earlier run alive; empty it explicitly.
    : > "$ignore_file"
  fi

  # Create codespell configuration
  printf '[codespell]\nignore-words = %s\ninteractive = 2\n' "$ignore_file" > "$config_file"

  # Handle skip files
  if [[ -n $skip_files ]]; then
    printf 'skip = %s\n' "$skip_files" >> "$config_file"
    info "Skipping files: $skip_files"
  fi

  # Display configuration
  info "Codespell configuration:"
  cat "$config_file"

  # Save current state before running codespell
  git add -A 2> /dev/null || true
  git stash push -m "before-spell-check" 2> /dev/null || true

  # Run codespell on markdown and text files. BSD find has no -regextype, so
  # select files with a zsh recursive glob instead; NUL-separate for xargs in
  # case of hostile filenames. codespell exits non-zero when it writes fixes,
  # so its status is not a failure.
  local -a spell_targets
  spell_targets=(**/*.(md|mdx|txt)(.N))
  if ((${#spell_targets} == 0)); then
    warn "No markdown or text files found to check"
    return 0
  fi
  info "Checking ${#spell_targets} files..."
  print -rN -- "${spell_targets[@]}" \
    | xargs -0 sh -c 'yes " " | uvx codespell --check-filenames --config "/tmp/codespell.cfg" -w "$@"' sh \
    || true
}

# Generate spell check report
generate_spell_report() {
  info "Generating spell check report..."

  local report_file="/tmp/spell-changes-report.txt"
  local summary_file="/tmp/spell-summary.txt"

  # Clear previous reports
  rm -f "$report_file"
  rm -f "$summary_file"

  # Get list of changed files
  local -a changed_files
  changed_files=($(git diff --name-only))

  if ((${#changed_files} == 0)); then
    return 1
  fi

  printf "${GREEN}=== SPELL CHECK REPORT ===${NC}\n\n" | tee -a "$report_file"
  printf "Total files modified: %d\n\n" "${#changed_files}" | tee -a "$report_file"

  local total_changes=0

  # Process each changed file
  for file in "${changed_files[@]}"; do
    if [[ ! -f $file ]]; then
      continue
    fi

    local file_diff=$(git diff "$file")
    # Get the diff for this file

    if [[ -z $file_diff ]]; then
      continue
    fi

    printf "${YELLOW}File: %s${NC}\n" "$file" | tee -a "$report_file"
    printf "─%.0s" {1..60} | tee -a "$report_file"
    printf "\n" | tee -a "$report_file"

    # Extract and display word changes (- lines = before, + lines = after)
    local changes_in_file=0
    local before_line=""
    local after_line=""

    # Parse diff output to extract changed words only. Glob matches, not =~:
    # macOS regcomp rejects the pattern '^+' outright ("repetition-operator
    # operand invalid"), which silently breaks the =~ version of this loop.
    echo "$file_diff" | grep -E '^[-+]' | grep -v -E '^(---|\+\+\+)' | while IFS= read -r line; do
      if [[ $line == -* ]]; then
        before_line="${line:1}"
      elif [[ $line == +* ]] && [[ -n $before_line ]]; then
        after_line="${line:1}"

        # Compare words and extract differences
        local -a before_words after_words
        before_words=(${(z)before_line})
        after_words=(${(z)after_line})

        # Find differing words by comparing position by position
        local max_len=${#before_words}
        ((${#after_words} > max_len)) && max_len=${#after_words}

        for ((i = 1; i <= max_len; i++)); do
          local before_word="${before_words[i]}"
          local after_word="${after_words[i]}"

          # If words differ, display them
          if [[ $before_word != "$after_word" ]]; then
            if [[ -n $before_word && -n $after_word ]]; then
              printf "  ${RED}%s${NC} → ${GREEN}%s${NC}\n" "$before_word" "$after_word" | tee -a "$report_file"
              # Post-increment returns the old value, so ((x++)) from 0 has
              # status 1 and ERR_EXIT kills the whole report. Plain assignment.
              changes_in_file=$((changes_in_file + 1))
            fi
          fi
        done

        before_line=""
        after_line=""
      fi
    done

    if ((changes_in_file > 0)); then
      total_changes=$((total_changes + changes_in_file))
      printf "\n" | tee -a "$report_file"
    fi
  done

  printf "${GREEN}=== SUMMARY ===${NC}\n" | tee -a "$report_file"
  printf "Total spelling corrections: %d\n" "$total_changes" | tee -a "$report_file"
  printf "Total files corrected: %d\n\n" "${#changed_files}" | tee -a "$report_file"

  info "Full report saved to: $report_file"

  return 0
}

# Check for changes
check_for_changes() {
  info "Checking for changes..."

  if ! git diff --exit-code --quiet; then
    info "Found spelling errors that were corrected"
    generate_spell_report
    return 0
  else
    info "No spelling errors found"
    return 1
  fi
}

# Setup git credentials
setup_git_credentials() {
  info "Setting up git credentials..."

  local git_user="${GITHUB_REPOSITORY_OWNER:-$(gh api user -q '.login')}"
  local git_email=$(gh api user/public_emails -q '.[0].email' 2> /dev/null || echo "${git_user}@users.noreply.github.com")

  git config user.name "$git_user"
  git config user.email "$git_email"
  git config url.https://$GH_TOKEN@github.com/.insteadOf https://github.com/
}

# Fork the repository
fork_repository() {
  info "Forking repository..."

  # `gh repo fork` exits 0 when the fork already exists and non-zero for reasons that are not
  # fatal, so its status is advisory only. The identity check below is the real gate: the slug
  # must exist, be a fork, and name the target as its parent — otherwise a same-named unrelated
  # repo would take the push. Forks are eventually consistent, so poll briefly. Note `gh`'s
  # parent object exposes owner.login/name — there is no nameWithOwner field on it, so the
  # slug is composed by hand.
  gh repo fork "$repo_name" --clone=false || {
    warn "Fork command returned non-zero; verifying fork state"
  }

  local parent=""
  for i in {1..5}; do
    parent=$(gh repo view --json isFork,parent -q 'select(.isFork) | "\(.parent.owner.login)/\(.parent.name)"' "$repo_fork" 2> /dev/null) || parent=""
    [[ ${(L)parent} == "${(L)repo_name}" ]] && break
    ((i < 5)) && sleep 3
  done

  if [[ ${(L)parent} != "${(L)repo_name}" ]]; then
    error "$repo_fork is not a fork of $repo_name (parent: ${parent:-none}); refusing to push."
  fi

  git remote set-url origin "https://github.com/${repo_fork}.git"
}

# Commit and push changes
commit_and_push() {
  info "Committing and pushing changes..."

  git switch --force-create docs/fix-spelling || error "Failed to create branch"
  git add -A || error "Failed to stage changes"
  git commit -m "docs: correct spelling" --signoff || error "Failed to commit changes"
  # A prior run leaves docs/fix-spelling on the fork; a fresh upstream clone can
  # never fast-forward onto it, so plain push rejects with "fetch first". The
  # branch is tool-owned and the fork's parentage was just verified, so --force
  # is safe. --force-with-lease cannot work here: this clone has no
  # remote-tracking ref for the fork, so the lease is always "stale".
  git push --force origin docs/fix-spelling || error "Failed to push changes"

  info "Changes pushed to: ${repo_fork_url}"
  info "Branch: docs/fix-spelling"
}

# Delete the fork
delete_fork_repo() {
  info "Deleting fork: $repo_fork"

  # Never delete on an unverified slug: it must exist and actually be a fork.
  local is_fork
  is_fork=$(gh repo view --json isFork -q '.isFork' "$repo_fork" 2> /dev/null) || {
    warn "Fork $repo_fork not found (nothing to delete)"
    return 0
  }

  if [[ $is_fork != "true" ]]; then
    error "$repo_fork is not a fork; refusing to delete."
  fi

  gh repo delete --yes "$repo_fork" || {
    warn "Failed to delete fork: $repo_fork"
  }
}

# Main function
main() {
  parse_args "$@"
  check_requirements
  get_repo_info

  local original_dir="$PWD"

  clone_repository
  run_spell_check

  if check_for_changes; then
    if ((dry_run == 1)); then
      info "Dry run: stopping before fork/push."
      info "A full run would fork $repo_name to $repo_fork and push branch docs/fix-spelling."
      info "Corrected clone left at: $PWD"
    else
      setup_git_credentials
      fork_repository
      commit_and_push

      info "Spell check completed successfully!"
      info "Please create a pull request from the fork to the original repository."
    fi
  else
    info "No changes needed. Repository is clean!"
  fi

  # Return to original directory
  cd "$original_dir"

  # Delete fork if requested
  if ((delete_fork == 1)); then
    if ((dry_run == 1)); then
      warn "Dry run: skipping fork deletion."
    else
      delete_fork_repo
    fi
  fi
}

# Run main function
main "$@"
